{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OntoDL+",
  "scopeName": "source.ontodlp",
  "fileTypes": ["odlp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#header" },
    { "include": "#sections" },
    { "include": "#imports" },
    { "include": "#types" },
    { "include": "#relation-metadata" },
    { "include": "#built-in-relations" },
    { "include": "#relation-properties" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.percentage.ontodlp",
          "match": "%[^\\r\\n]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ontodlp",
          "begin": "\"",
          "end": "\"|(?=$)",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ontodlp" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ontodlp" } }
        },
        {
          "name": "string.quoted.single.ontodlp",
          "begin": "'",
          "end": "'|(?=$)",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ontodlp" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ontodlp" } }
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(Ontologia|Ontology)([ \\t]+)([A-Za-z\\u00C0-\\u024F][A-Za-z0-9_\\-/\\u00C0-\\u024F]*)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "captures": {
            "1": { "name": "keyword.control.ontology.ontodlp" },
            "3": { "name": "entity.name.namespace.ontodlp" }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:Ontologia|Ontology)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "keyword.control.ontology.ontodlp"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:propriedadesObjetos|propriedadesDados|objectProperties|dataProperties|relationships|restrictions|individuals|attributes|individuos|restricoes|atributos|conceitos|concepts|relacoes|classes|triplos|triples)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "keyword.control.section.ontodlp"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:expand)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "keyword.control.import.ontodlp"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:string|enum|int)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "storage.type.primitive.ontodlp"
        }
      ]
    },
    "relation-metadata": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:contradominio|counterdomain|codiminio|codomain|dominio|domain|props)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "keyword.other.relation-metadata.ontodlp"
        }
      ]
    },
    "built-in-relations": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:instanceof|subClassOf|instancia|subclasse|sinonimo|synonym|partOf|parte|type|is\\-a|iof|pof|a)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "keyword.operator.relation.ontodlp"
        }
      ]
    },
    "relation-properties": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:representation|representacao|abstraction|sobrejetiva|sobrejecao|surjection|surjective|bijection|injection|abstracao|injective|inversaDe|inverseOf|function|injetiva|bijecao|injecao|simples|inteira|funcao|simple|entire)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "constant.language.relation-property.ontodlp"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "=\\[|:-|=>|\\\\=|==|=", "name": "keyword.operator.ontodlp" },
        { "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])(?:not|nao)(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])", "name": "keyword.operator.logical.ontodlp" },
        { "match": "!", "name": "keyword.operator.logical.ontodlp" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])-?[0-9]+(?![0-9])", "name": "constant.numeric.integer.ontodlp" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "[{}\\[\\]()]", "name": "punctuation.section.ontodlp" },
        { "match": "[,;:.]", "name": "punctuation.separator.ontodlp" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_\\-/\\u00C0-\\u024F])[A-Za-z\\u00C0-\\u024F][A-Za-z0-9_\\-/\\u00C0-\\u024F]*(?![A-Za-z0-9_\\-/\\u00C0-\\u024F])",
          "name": "variable.other.ontodlp"
        }
      ]
    }
  }
}
